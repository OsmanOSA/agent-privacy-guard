  "cards": [
    {
      "dot": "emerald",
      "title": "Inspection on each covered read",
      "items": [
        "Python (.py), other code and config: rules + name heuristics; no NER on Read.",
        "Document text (.txt, .md, .csv and declared extensions): local name service.",
        "Rules still run with NER; optional INSEE and known session names add matches."
      ]
    },
    {
      "dot": "cyan",
      "title": "Restoration and feedback",
      "items": [
        "After eligible Write, restore personal values on disk; keep credentials masked.",
        "A covered reread is inspected again. Token-bearing Edit is guided to Write.",
        "Desktop delivery is optional and grouped; background mode checks host focus."
      ]
    },
    {
      "dot": "amber",
      "title": "Prototype boundary",
      "items": [
        "Tool-returned strings only; model-network interception remains unverified.",
        "A PDF/Word extension selects the text profile, not a built-in file extractor.",
        "Images/OCR, typed prompts and final chat restoration are outside this flow."
      ]
    }
  ]
